# Kosongkan jika frontend disajikan dari domain yang sama dengan Laravel (bawaan: hasil build masuk ke backend/public).
# Isi hanya jika frontend di-hosting di domain lain, lalu jalankan ulang `npm run build`.
# Jangan lupa tambahkan domain frontend ke CORS_ALLOWED_ORIGINS di backend/.env.
VITE_API_URL=https://cakramasta.terraetloka.id/